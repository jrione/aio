# ============================================================
#  Dibuat otomatis dari env.defaults.js — JANGAN diedit manual.
#  Ubah env.defaults.js lalu jalankan: npm run env:example
# ============================================================
#
#  Setup lokal:  cp .env.example .env
#  Semua nilai di bawah terbundel ke sisi klien dan bisa dibaca
#  siapa pun — jangan pernah menaruh secret di sini.

# ── Aplikasi ────────────────────────────────────────────────
# Nama aplikasi. Dipakai di <title> dan header layout.
VITE_APP_NAME=AIO DevOps

# Label lingkungan: development | staging | production.
VITE_APP_ENV=development

# ── API (Issue #8) ──────────────────────────────────────────
# Base URL backend. Semua request lewat HTTP client terpusat.
VITE_API_BASE_URL=/api

# Timeout request dalam milidetik.
VITE_API_TIMEOUT=15000

# true = pakai mock data, false = hit API asli. Tanpa ubah komponen.
VITE_USE_MOCK=true
