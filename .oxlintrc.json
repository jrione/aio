{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Plugin yang aktif. oxlint mengimplementasikan ulang plugin-plugin ESLint
  // ini secara native, termasuk react-hooks (di dalam "react") dan
  // @typescript-eslint (di dalam "typescript"). Lihat bagian Linter di README
  // untuk alasan project ini memakai oxlint alih-alih ESLint.
  "plugins": ["eslint", "oxc", "typescript", "react", "import", "jsx-a11y", "promise", "node"],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },

  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    // JSX transform baru (jsx: react-jsx di tsconfig) tidak butuh React di scope.
    "react/react-in-jsx-scope": "off",

    // Alias @/ wajib untuk impor lintas-direktori; path relatif hanya boleh
    // menunjuk file tetangga di folder yang sama.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*", "../**"],
            "message": "Impor lintas-direktori memakai alias @/ — lihat bagian Path alias di README."
          }
        ]
      }
    ]
  },

  "overrides": [
    {
      // Entry point memang mengimpor CSS demi efek sampingnya (Issue #3).
      "files": ["src/main.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      // env.defaults.ts tinggal di root, di luar jangkauan alias @/ yang
      // menunjuk src/. Dua file inilah satu-satunya yang boleh menjangkaunya.
      "files": ["src/config/env.ts", "src/vite-env.d.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // File-file ini membangun objeknya secara dinamis dari sebuah tabel
      // (ENV_SCHEMA, ROUTE_TABLE), sementara bentuk akhirnya sudah dijamin
      // oleh tipe turunan di atasnya. Cast-nya disengaja dan sudah dijelaskan
      // di tempatnya masing-masing; aturan type-aware ini tidak bisa melihat
      // jaminan itu.
      "files": ["src/config/env.ts", "env.defaults.ts", "src/routes/routes.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      // router.tsx memang mengekspor objek router, bukan komponen — itu
      // memutus Fast Refresh untuk file ini. Tidak jadi masalah: routernya
      // dirakit sekali saat modul dimuat, jadi mengubahnya selalu menuntut
      // reload penuh. Halaman-halamannya sendiri tetap ber-Fast Refresh
      // karena tinggal di file terpisah dan dimuat lewat lazy().
      "files": ["src/routes/router.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // Modal memasang onClick di <dialog> untuk menutup saat backdrop diklik.
      // jsx-a11y menganggap <dialog> elemen non-interaktif, jadi aturannya
      // menuntut listener keyboard pendamping. Di sini tidak diperlukan:
      // showModal() sudah membuat Escape menutup dialog secara native, dan
      // ada tombol tutup yang bisa difokus. Handler klik ini murni tambahan
      // untuk pengguna tetikus, bukan satu-satunya jalan keluar.
      "files": ["src/components/ui/Modal.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      // scripts/ dijalankan langsung oleh Node, yang tidak meresolusi alias @/.
      // CLI-nya juga memang menulis ke console.
      "files": ["scripts/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "no-console": "off"
      }
    },
    {
      // vite.config.ts & env.defaults.ts dimuat di luar konteks alias.
      "files": ["vite.config.ts", "env.defaults.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

  "ignorePatterns": ["dist", "node_modules", "coverage"]
}
