{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],

    /* Impor memakai ekstensi .ts eksplisit agar file di scripts/ bisa
       dijalankan langsung oleh Node lewat type stripping. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Vite yang melakukan transpilasi; tsc hanya dipakai untuk type checking. */
    "noEmit": true,
    "skipLibCheck": true,

    /* Larang sintaks TypeScript yang tidak bisa dihapus begitu saja
       (enum, parameter property) supaya Node type stripping tetap jalan. */
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "scripts", "vite.config.ts", "env.defaults.ts"]
}
